{
  "name": "@ocap/kernel-test",
  "version": "0.0.0",
  "private": true,
  "description": "Run tests on the kernel that involve interaction with vats",
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-test#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./minimal-cluster": "./src/vats/default/minimal-cluster.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "ocap bundle src/vats",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo './src/**/*.bundle' ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@agoric/store": "0.10.0",
    "@endo/eventual-send": "^1.5.0",
    "@endo/exo": "^1.7.0",
    "@endo/marshal": "^1.10.0",
    "@endo/patterns": "^1.9.1",
    "@endo/promise-kit": "^1.2.1",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/peer-id": "6.0.5",
    "@metamask/kernel-node-runtime": "workspace:^",
    "@metamask/kernel-store": "workspace:^",
    "@metamask/kernel-utils": "workspace:^",
    "@metamask/logger": "workspace:^",
    "@metamask/ocap-kernel": "workspace:^",
    "@ocap/kernel-language-model-service": "workspace:^",
    "@ocap/nodejs-test-workers": "workspace:^",
    "@ocap/remote-iterables": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@metamask/kernel-cli": "workspace:^",
    "@metamask/kernel-shims": "workspace:^",
    "@ocap/repo-tools": "workspace:^",
    "depcheck": "^1.4.7",
    "jsdom": "^29.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
