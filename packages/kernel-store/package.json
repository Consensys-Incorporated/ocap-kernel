{
  "name": "@metamask/kernel-store",
  "version": "0.6.0",
  "description": "Ocap Kernel storage abstractions and implementations",
  "keywords": [
    "MetaMask",
    "object capabilities",
    "ocap"
  ],
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-store#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite/nodejs": {
      "types": "./dist/sqlite/nodejs.d.ts",
      "default": "./dist/sqlite/nodejs.js"
    },
    "./sqlite/wasm": {
      "types": "./dist/sqlite/wasm.d.ts",
      "default": "./dist/sqlite/wasm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/kernel-store",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/kernel-store",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@metamask/logger": "workspace:^",
    "@sqlite.org/sqlite-wasm": "^3.49.1-build3",
    "better-sqlite3": "^13.0.3",
    "ses": "^2.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@metamask/auto-changelog": "^6.2.1",
    "@ocap/repo-tools": "workspace:^",
    "@types/better-sqlite3": "^7.6.12",
    "depcheck": "^1.4.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
