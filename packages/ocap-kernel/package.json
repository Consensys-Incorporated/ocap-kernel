{
  "name": "@metamask/ocap-kernel",
  "version": "0.7.0",
  "description": "OCap kernel core components",
  "keywords": [
    "MetaMask",
    "object capabilities",
    "ocap"
  ],
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/ocap-kernel#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/ocap-kernel",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/ocap-kernel",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@agoric/swingset-liveslots": "0.11.0",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/marshal": "^1.10.0",
    "@endo/pass-style": "^1.8.2",
    "@endo/promise-kit": "^1.2.1",
    "@libp2p/bootstrap": "12.0.15",
    "@libp2p/circuit-relay-v2": "4.1.7",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/identify": "4.0.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/peer-id": "6.0.5",
    "@libp2p/ping": "3.0.14",
    "@libp2p/utils": "7.0.14",
    "@libp2p/webrtc": "6.0.15",
    "@libp2p/websockets": "10.1.7",
    "@libp2p/webtransport": "6.0.16",
    "@metamask/kernel-errors": "workspace:^",
    "@metamask/kernel-platforms": "workspace:^",
    "@metamask/kernel-rpc-methods": "workspace:^",
    "@metamask/kernel-store": "workspace:^",
    "@metamask/kernel-utils": "workspace:^",
    "@metamask/logger": "workspace:^",
    "@metamask/rpc-errors": "^7.0.3",
    "@metamask/snaps-execution-environments": "^11.3.2",
    "@metamask/streams": "workspace:^",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/utils": "^12.0.0",
    "@multiformats/multiaddr": "^13.0.1",
    "@scure/bip39": "^2.0.1",
    "libp2p": "3.1.7",
    "multiformats": "^13.3.6",
    "ses": "^2.3.0",
    "setimmediate": "^1.0.5",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@ocap/repo-tools": "workspace:^",
    "@types/setimmediate": "^1.0.4",
    "depcheck": "^1.4.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
