# Settings for the performance profiles. A variable set in the environment
# overrides the value here for that run. Lists are comma-separated.

# kref-scaling: live krefs grow to 1e<MAX_EXPONENT>, with SAMPLES sends timed
# at each power of ten, over each of PAIRS holder/minter vat pairs.
KREF_PERF_MAX_EXPONENT=6
KREF_PERF_SAMPLES=50
KREF_PERF_PAIRS=1,4,16,64

# concurrent-load: KREFS live krefs over each of PAIRS pairs, sending MESSAGES
# messages per cell at each CONCURRENCY.
LOAD_PERF_KREFS=100000
LOAD_PERF_PAIRS=1,8,64
LOAD_PERF_CONCURRENCY=1,4,16,64,256
LOAD_PERF_MESSAGES=1000
