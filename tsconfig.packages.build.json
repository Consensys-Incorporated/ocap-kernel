{
  "extends": "./tsconfig.packages.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "paths": {
      "@ocap/*": ["./packages/*/src"]
    },
    "skipLibCheck": true,
    "sourceMap": true
  },
  "exclude": [
    "**/vite.config.ts",
    "**/vitest.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
