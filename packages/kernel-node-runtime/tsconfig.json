{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "types": ["node", "ses", "vitest"]
  },
  "include": [
    "../../vitest.config.ts",
    "./src/**/*.ts",
    "./src/**/*-trusted-prelude.js",
    "./test/**/*.ts",
    "./vitest.config.ts",
    "./vitest.config.e2e.ts"
  ],
  "exclude": ["./test/workers/*.js"]
}
