{
  "name": "@metamask/kernel-node-runtime",
  "version": "0.1.0",
  "description": "For running Ocap Kernel experiments in a Node.js environment",
  "keywords": [
    "MetaMask",
    "object capabilities",
    "ocap"
  ],
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-node-runtime#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "default": "./dist/daemon/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/kernel-node-runtime",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/kernel-node-runtime",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:ci": "./scripts/test-e2e-ci.sh",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@chainsafe/libp2p-quic": "^2.0.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/promise-kit": "^1.2.1",
    "@libp2p/interface": "3.3.0",
    "@libp2p/tcp": "11.0.14",
    "@libp2p/webrtc": "6.0.15",
    "@metamask/kernel-platforms": "workspace:^",
    "@metamask/kernel-rpc-methods": "workspace:^",
    "@metamask/kernel-shims": "workspace:^",
    "@metamask/kernel-store": "workspace:^",
    "@metamask/kernel-utils": "workspace:^",
    "@metamask/logger": "workspace:^",
    "@metamask/ocap-kernel": "workspace:^",
    "@metamask/streams": "workspace:^",
    "ses": "^2.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@endo/captp": "4.5.0",
    "@metamask/auto-changelog": "^6.2.1",
    "@ocap/repo-tools": "workspace:^",
    "@types/node": "^22.13.1",
    "depcheck": "^1.4.7",
    "node-gyp": "^11.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
