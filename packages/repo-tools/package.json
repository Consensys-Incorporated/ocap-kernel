{
  "name": "@ocap/repo-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Vite plugins for Ocap Kernel development",
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/repo-tools#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "type": "module",
  "exports": {
    "./build-utils/oxfmt-config": "./src/build-utils/oxfmt-config.ts",
    "./build-utils/test": "./src/build-utils/test.ts",
    "./build-utils/vite": "./src/build-utils/vite.ts",
    "./test-utils": "./src/test-utils/index.ts",
    "./test-utils/extension": "./src/test-utils/extension.ts",
    "./test-utils/fetch-mock": "./src/test-utils/env/fetch-mock.ts",
    "./test-utils/fetch-input": "./src/test-utils/fetch-input.ts",
    "./test-utils/mock-endoify": "./src/test-utils/env/mock-endoify.ts",
    "./test-utils/streams": "./src/test-utils/streams.ts",
    "./vite-plugins": "./src/vite-plugins/index.ts",
    "./vitest-config": "./src/vitest-config.js",
    "./vitest-reporters/silent": "./src/vitest-reporters/silent-reporter.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "devDependencies": {
    "@metamask/superstruct": "^3.4.1",
    "@playwright/test": "^1.59.1",
    "@vitest/runner": "4.1.11",
    "cheerio": "^1.0.0",
    "depcheck": "^1.4.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3",
    "vitest-fetch-mock": "^0.4.5"
  },
  "engines": {
    "node": ">=22"
  }
}
