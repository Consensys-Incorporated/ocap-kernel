{
  "name": "@metamask/kernel-ui",
  "version": "0.5.0",
  "description": "Kernel control panel UI",
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-ui#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "keywords": [
    "MetaMask",
    "object capabilities",
    "ocap"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "build": "yarn build:lib && yarn build:vite",
    "build:lib": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:vite": "vite build --configLoader runner --config vite.config.ts",
    "dev": "vite build --configLoader runner --config vite.config.ts --mode development --watch",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/kernel-ui",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/kernel-ui",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@metamask/design-system-react": "^0.47.0",
    "@metamask/design-system-tailwind-preset": "^0.15.0",
    "@metamask/design-tokens": "^12.0.0",
    "@metamask/kernel-browser-runtime": "workspace:^",
    "@metamask/kernel-rpc-methods": "workspace:^",
    "@metamask/kernel-utils": "workspace:^",
    "@metamask/logger": "workspace:^",
    "@metamask/ocap-kernel": "workspace:^",
    "@metamask/utils": "^12.0.0",
    "tailwindcss": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@metamask/auto-changelog": "^6.2.1",
    "@ocap/repo-tools": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.313",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "depcheck": "^1.4.7",
    "jsdom": "^29.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
