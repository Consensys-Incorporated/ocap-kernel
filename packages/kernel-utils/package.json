{
  "name": "@metamask/kernel-utils",
  "version": "0.5.0",
  "description": "A kitchen drawer of Ocap Kernel utilities",
  "keywords": [
    "MetaMask",
    "object capabilities",
    "ocap"
  ],
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-utils#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exo": {
      "types": "./dist/exo.d.ts",
      "default": "./dist/exo.js"
    },
    "./json-schema-to-struct": {
      "types": "./dist/json-schema-to-struct.d.ts",
      "default": "./dist/json-schema-to-struct.js"
    },
    "./discoverable": {
      "types": "./dist/discoverable.d.ts",
      "default": "./dist/discoverable.js"
    },
    "./described": {
      "types": "./dist/described.d.ts",
      "default": "./dist/described.js"
    },
    "./libp2p": {
      "types": "./dist/libp2p-relay.d.ts",
      "default": "./dist/libp2p-relay.js"
    },
    "./nodejs": {
      "types": "./dist/nodejs/index.d.ts",
      "default": "./dist/nodejs/index.js"
    },
    "./vite-plugins": {
      "types": "./dist/vite-plugins/index.d.ts",
      "default": "./dist/vite-plugins/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/kernel-utils",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/kernel-utils",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "^1.5.0",
    "@endo/exo": "^1.7.0",
    "@endo/pass-style": "^1.8.2",
    "@endo/patterns": "^1.9.1",
    "@endo/promise-kit": "^1.2.1",
    "@libp2p/autonat": "3.0.14",
    "@libp2p/circuit-relay-v2": "4.1.7",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/identify": "4.0.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/ping": "3.0.14",
    "@libp2p/tcp": "11.0.14",
    "@libp2p/websockets": "10.1.7",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/utils": "^12.0.0",
    "@multiformats/multiaddr": "^13.0.1",
    "libp2p": "3.1.7",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/kernel-errors": "workspace:^",
    "@ocap/repo-tools": "workspace:^",
    "@types/setimmediate": "^1.0.4",
    "depcheck": "^1.4.7",
    "jsdom": "^29.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "ses": "^2.3.0",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "acorn": "^8.15.0",
    "rolldown": "^1.0.0-rc.0",
    "vite": "^8.0.6"
  },
  "peerDependenciesMeta": {
    "acorn": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
