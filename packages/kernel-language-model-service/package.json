{
  "name": "@ocap/kernel-language-model-service",
  "version": "0.0.0",
  "private": true,
  "description": "A place for implementations providing language model services to the ocap kernel",
  "homepage": "https://github.com/Consensys-Incorporated/ocap-kernel/tree/main/packages/kernel-language-model-service#readme",
  "bugs": {
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Consensys-Incorporated/ocap-kernel.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./open-v1/nodejs": {
      "types": "./dist/open-v1/nodejs.d.ts",
      "default": "./dist/open-v1/nodejs.js"
    },
    "./ollama/nodejs": {
      "types": "./dist/ollama/nodejs.d.ts",
      "default": "./dist/ollama/nodejs.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "default": "./dist/test-utils/index.js"
    },
    "./utils/parse-tool-arguments": {
      "types": "./dist/utils/parse-tool-arguments.d.ts",
      "default": "./dist/utils/parse-tool-arguments.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf --glob ./dist './*.tsbuildinfo' && tsc --project tsconfig.build.json",
    "build:docs": "npx -y -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "changelog:validate": "../../scripts/validate-changelog.sh @ocap/kernel-language-model-service",
    "clean": "rimraf --glob './*.tsbuildinfo' ./coverage ./dist ./.turbo ./logs",
    "lint": "yarn lint:oxlint && yarn lint:oxfmt && yarn constraints && yarn lint:dependencies",
    "lint:dependencies": "depcheck --quiet",
    "lint:fix": "yarn lint:oxlint --fix && oxfmt . && yarn constraints --fix && yarn lint:dependencies",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:clean": "yarn test --no-cache --coverage.clean",
    "test:dev": "yarn test --mode development",
    "test:types": "tsc --project tsconfig.json",
    "test:verbose": "yarn test --reporter verbose",
    "test:watch": "vitest --config vitest.config.ts",
    "test:dev:quiet": "yarn test:dev --reporter @ocap/repo-tools/vitest-reporters/silent"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/streams": "workspace:^",
    "@ocap/repo-tools": "workspace:^",
    "@types/chrome": "^0.0.313",
    "depcheck": "^1.4.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.6",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@endo/eventual-send": "^1.5.0",
    "@metamask/kernel-utils": "workspace:^",
    "@metamask/superstruct": "^3.4.1",
    "ollama": "^0.5.16",
    "ses": "^2.3.0"
  }
}
