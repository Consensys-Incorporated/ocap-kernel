{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "types": [
      "chrome",
      "vitest",
      "vitest/jsdom",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "../../vitest.config.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./test/**/*.ts",
    "./test/**/*.tsx",
    "./vite.config.ts",
    "./vitest.config.ts"
  ]
}
